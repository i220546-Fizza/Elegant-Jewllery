PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas). The database name is
# fixed in code to "elegant_jewellery" (see config/db.js) so this app always
# uses its own database even if this URI points at a cluster shared with
# another project - any /dbname path segment here is ignored.
MONGO_URI=mongodb://127.0.0.1:27017/elegant_jewellery

# JWT secret used to sign auth tokens - replace with a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Comma-separated list of origins allowed to call this API
CLIENT_URL=http://localhost:5173

# Credentials used only by seed/seedProducts.js to create the first admin account
ADMIN_NAME=Elegant Admin
ADMIN_EMAIL=admin@elegantjewellery.com
ADMIN_PASSWORD=ChangeMe123!
